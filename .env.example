# Core production services
# Include the database name in the path. Without it the driver connects to
# "test" and the CMS would read from a different database than it writes to.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/paperfoundation?retryWrites=true&w=majority
NEXTAUTH_SECRET=
# Both URLs must be the public HTTPS origin in production. They drive canonical
# tags, Open Graph URLs, the sitemap and sign-in callbacks.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First MongoDB owner account
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_PREVIEW_MODE=false

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail API campaigns
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Random secret used by the recurring campaign delivery worker
CRON_SECRET=

# Optional analytics
NEXT_PUBLIC_GA_ID=
